{
  "name": "burnnbyte",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 prisma migrate deploy && next build",
    "migrate:deploy": "PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 prisma migrate deploy",
    "admin:grant": "node scripts/grant-admin.js",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "mobile:sync": "npm --workspace apps/mobile run sync",
    "mobile:add:android": "npm --workspace apps/mobile run add:android",
    "mobile:add:ios": "npm --workspace apps/mobile run add:ios"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@fullcalendar/daygrid": "^6.1.17",
    "@fullcalendar/interaction": "^6.1.17",
    "@fullcalendar/react": "^6.1.17",
    "@prisma/client": "^6.11.1",
    "bcrypt": "^6.0.0",
    "lucide-react": "^0.548.0",
    "next": "15.5.9",
    "next-auth": "^4.24.7",
    "openai": "^5.12.2",
    "pg": "^8.15.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.3.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.7",
    "prisma": "^6.9.0"
  }
}
